---
layout: base.njk
title: Archivo
permalink: /archivo/
---
<section class="contenedor contenedor--estrecho pagina">
  <nav class="miga" aria-label="Ruta"><a href="/">Inicio</a> <span aria-hidden="true">/</span> <span aria-current="page">Archivo</span></nav>
  <h1>Archivo</h1>
  <p class="pagina__intro">Todas las entradas publicadas, de la más reciente a la más antigua ({{ collections.entradas.length }} en total).</p>
  {%- for anio, items in collections.entradas | groupby("data.anio") %}
  <h2 class="archivo__anio">{{ anio }}</h2>
  <ol class="archivo">
    {%- for e in items %}
    <li>
      <time datetime="{{ e.date | fechaISO }}">{{ e.date | fecha }}</time>
      <a href="{{ e.url }}">{{ e.data.title }}</a>
      <span class="archivo__tags">{% for t in e.data.tags %}{% if t != "post" %}#{{ t }} {% endif %}{% endfor %}</span>
    </li>
    {%- endfor %}
  </ol>
  {%- endfor %}
</section>
