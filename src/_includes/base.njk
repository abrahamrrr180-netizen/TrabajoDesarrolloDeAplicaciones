<!doctype html>
<html lang="{{ site.idioma }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} - {% endif %}{{ site.titulo }}</title>
  <meta name="description" content="{{ resumen or site.descripcion }}">
  <meta name="author" content="{{ site.autor }}">
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="cabecera">
    <div class="contenedor">
      <a class="marca" href="/">{{ site.titulo }}</a>
      <nav class="menu">
        {%- set secciones = [["Inicio", "/"], ["Archivo", "/archivo/"], ["Etiquetas", "/etiquetas/"], ["Sobre mí", "/sobre-mi/"]] -%}
        {%- for s in secciones %}
        <a href="{{ s[1] }}"{% if page.url == s[1] %} class="activo"{% endif %}>{{ s[0] }}</a>
        {%- endfor %}
      </nav>
    </div>
  </header>

  <main class="contenedor">
    {{ content | safe }}
  </main>

  <footer class="pie">
    <div class="contenedor">
      <p>{{ site.autor }} · 2026 · Hecho con HTML, CSS y Eleventy</p>
    </div>
  </footer>
</body>
</html>
